#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local description="$1"
  shift
  printf '\n==> %s\n' "$description"
  time "$@"
}

if ! command -v node >/dev/null 2>&1; then
  printf 'Node.js is required but was not found.\n' >&2
  exit 1
fi

node_major="$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
if ((node_major < 20)); then
  printf 'Node.js 20 or newer is required; found %s.\n' "$(node --version)" >&2
  exit 1
fi

if ! command -v corepack >/dev/null 2>&1; then
  printf 'Corepack is required but was not found.\n' >&2
  exit 1
fi

mkdir -p "$HOME/.local/bin"
run_step "Activating the repository's pinned pnpm" \
  corepack enable --install-directory "$HOME/.local/bin" pnpm
hash -r

run_step "Installing workspace dependencies" \
  pnpm install --frozen-lockfile
run_step "Creating local development environment files" \
  pnpm env:sync
run_step "Generating Prisma Client" \
  pnpm db:generate

printf '\nOrb setup complete (Node %s, pnpm %s).\n' \
  "$(node --version)" "$(pnpm --version)"
