{
  "expo": {
    "name": "Rewards Tracker",
    "slug": "rewards-tracker-ynab",
    "version": "0.1.0",
    "scheme": "ynabcounter",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yingjie.ynabcounter"
    },
    "android": {
      "package": "com.yingjie.ynabcounter"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
